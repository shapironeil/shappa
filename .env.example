# Shappa - Environment Variables Template
# Copia questo file in .env e compila con i tuoi valori reali

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ===========================================
# DATABASE (MongoDB Atlas)
# ===========================================
# Connection string da MongoDB Atlas
# Formato: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://shappa_app:YOUR_PASSWORD_HERE@cluster0.xxxxx.mongodb.net/shappa?retryWrites=true&w=majority

# ===========================================
# AMAZON API (per scraping/monitoring)
# ===========================================
# OpenWebNinja API Key (gratis: https://openwebninja.com/)
OPENWEBNINJA_API_KEY=your_openwebninja_key_here

# SerpApi Key (opzionale, per ricerche Amazon avanzate)
SERPAPI_KEY=your_serpapi_key_here

# ===========================================
# EBAY API (per listing)
# ===========================================
# Production Keys (da https://developer.ebay.com/)
EBAY_CLIENT_ID=your_production_client_id
EBAY_CLIENT_SECRET=your_production_client_secret
EBAY_DEV_ID=your_dev_id
EBAY_REDIRECT_URI=https://shappa.me/auth/ebay/callback

# Sandbox Keys (per testing)
EBAY_SANDBOX_CLIENT_ID=your_sandbox_client_id
EBAY_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret
EBAY_SANDBOX_REDIRECT_URI=http://localhost:3000/auth/ebay/callback

# ===========================================
# NOTIFICHE
# ===========================================
# Telegram Bot (gratis: https://core.telegram.org/bots#botfather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email (SendGrid gratis: https://sendgrid.com/)
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@shappa.me

# ===========================================
# MONITORING
# ===========================================
# Intervallo controllo prezzi (millisecondi)
# 300000 = 5 minuti, 600000 = 10 minuti
MONITORING_INTERVAL=300000

# Sentry (error tracking - gratis Student Pack)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ===========================================
# SICUREZZA
# ===========================================
# Session secret (genera stringa casuale lunga)
SESSION_SECRET=genera_una_stringa_casuale_molto_lunga_e_sicura

# JWT Secret (per autenticazione API)
JWT_SECRET=altra_stringa_casuale_per_jwt

# ===========================================
# OPZIONALE
# ===========================================
# Log level (info, warn, error, debug)
LOG_LEVEL=info

# Datadog API Key (monitoring server)
DATADOG_API_KEY=your_datadog_key
