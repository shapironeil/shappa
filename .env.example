# Shappa - Environment Variables Template
# Copia questo file in .env e compila con i tuoi valori reali

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=3000

# ===========================================
# DATABASE (MongoDB Atlas)
# ===========================================
# Connection string da MongoDB Atlas
# Formato: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://shappa_app:YOUR_PASSWORD_HERE@cluster0.xxxxx.mongodb.net/shappa?retryWrites=true&w=majority

# ===========================================
# EBAY OAUTH (Production)
# ===========================================
# Ottieni le credenziali da: https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=your_production_client_id
EBAY_CLIENT_SECRET=your_production_client_secret
EBAY_DEV_ID=your_dev_id_optional
EBAY_RUNAME=your_ru_name_optional
EBAY_REDIRECT_URI=https://shapiro.ninja/auth/ebay/callback

# URL eBay (opzionali, usa default se non specificati)
# EBAY_AUTH_URL=https://auth.ebay.com/oauth2/authorize
# EBAY_TOKEN_URL=https://api.ebay.com/identity/v1/oauth2/token
# EBAY_API_URL=https://api.ebay.com
# EBAY_SCOPES=https://api.ebay.com/oauth/api_scope https://api.ebay.com/oauth/api_scope/sell.inventory
# EBAY_MARKETPLACE_ID=EBAY_IT

# ===========================================
# EBAY SANDBOX (Development/Testing)
# ===========================================
# Sandbox Keys per sviluppo locale
# EBAY_SANDBOX_CLIENT_ID=your_sandbox_client_id
# EBAY_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret
# EBAY_SANDBOX_REDIRECT_URI=https://localhost:3000/auth/ebay/callback

# ===========================================
# AMAZON SCRAPING
# ===========================================
# Demo mode (usa dati fittizi per testing senza API)
# USE_AMAZON_DEMO=1

# OpenWebNinja API Key (opzionale: https://openwebninja.com/)
# OPENWEBNINJA_API_KEY=your_openwebninja_key_here

# SerpApi Key (opzionale: https://serpapi.com/)
# SERPAPI_KEY=your_serpapi_key_here

# ===========================================
# SSL/HTTPS (Development)
# ===========================================
# Disabilita HTTPS in locale (usa solo HTTP)
# DISABLE_HTTPS=true

# Passphrase per certificato PFX (se usi SSL locale)
# DEV_PFX_PASSPHRASE=shappa-dev

# ===========================================
# ADMIN & SECURITY (Opzionali)
# ===========================================
# Token admin per endpoint protetti
# ADMIN_TOKEN=your_secure_admin_token_here

# Session secret (genera stringa casuale lunga per produzione)
# SESSION_SECRET=genera_una_stringa_casuale_molto_lunga_e_sicura

# JWT Secret (per autenticazione API)
# JWT_SECRET=altra_stringa_casuale_per_jwt

# ===========================================
# MONITORING & LOGGING (Opzionali)
# ===========================================
# Intervallo controllo prezzi (millisecondi)
# MONITORING_INTERVAL=1800000  # 30 minuti default

# Log level (info, warn, error, debug)
# LOG_LEVEL=info

# ===========================================
# NOTIFICHE
# ===========================================
# Telegram Bot (gratis: https://core.telegram.org/bots#botfather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email (SendGrid gratis: https://sendgrid.com/)
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@shappa.me

# ===========================================
# MONITORING
# ===========================================
# Intervallo controllo prezzi (millisecondi)
# 300000 = 5 minuti, 600000 = 10 minuti
MONITORING_INTERVAL=300000

# Sentry (error tracking - gratis Student Pack)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ===========================================
# SICUREZZA
# ===========================================
# Session secret (genera stringa casuale lunga)
SESSION_SECRET=genera_una_stringa_casuale_molto_lunga_e_sicura

# JWT Secret (per autenticazione API)
JWT_SECRET=altra_stringa_casuale_per_jwt

# ===========================================
# OPZIONALE
# ===========================================
# Log level (info, warn, error, debug)
LOG_LEVEL=info

# Datadog API Key (monitoring server)
DATADOG_API_KEY=your_datadog_key
